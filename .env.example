# ============================================================================
# .env.example - Mau thiet lap bien moi truong he thong Task Tracker (De 24)
# Sao chep tep nay thanh .env truoc khi khoi chay: cp .env.example .env
# ============================================================================

# 1. Co so du lieu PostgreSQL (Quan tri vien & Ung dung)
POSTGRES_DB=taskdb
POSTGRES_USER=tt_admin
POSTGRES_PASSWORD=StrongAdminPassword2024!@#

# 2. Mat khau cho role ung dung tt_app (Chi co SELECT/INSERT/UPDATE/DELETE)
APP_DB_PASSWORD=StrongAppSecretPassword2024!@#

# 3. Mat khau cho role giam sat tt_monitor (Postgres Exporter)
MONITOR_DB_PASSWORD=StrongMonitorPassword2024!@#

# 4. Tai khoan quan tri pgAdmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=AdminPgSecret2024!@#

# 5. Tai khoan quan tri Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=AdminGrafanaSecret2024!@#
